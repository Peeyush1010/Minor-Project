{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Start FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app.main:app", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Run Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Forecast Model",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.pipeline.forecast.model",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
